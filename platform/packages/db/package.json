{
  "name": "@mamal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:setup": "psql -d ${PGDATABASE:-mamal_dev} -v ON_ERROR_STOP=1 -f scripts/test-setup.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.5.4",
    "@mamal/seo-checks": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
